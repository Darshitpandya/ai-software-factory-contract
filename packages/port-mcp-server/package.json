{
  "name": "@factory/port-mcp-server",
  "version": "1.0.0",
  "private": true,
  "description": "MCP server exposing Port catalog as read-only tools for AI factory stages",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "import": "./dist/index.js", "types": "./dist/index.d.ts" } },
