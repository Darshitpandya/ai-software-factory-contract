# Dependencies
node_modules/

# Build outputs
dist/
*.tsbuildinfo

# Environment — never commit real credentials
.env
.env.local
*.env

# Package manager
pnpm-lock.yaml.bak

# Test coverage
coverage/
.cache/

# Evidence — workspace context files are auto-seeded by the coordinator at runtime.
# They contain no Claude-produced content; only the actual output files matter.
evidence/runs/*/workspace/README.md
evidence/runs/*/workspace/work-order.json

# Terraform — state files and local variable overrides contain secrets
infra/terraform/.terraform/
infra/terraform/.terraform.lock.hcl
infra/terraform/terraform.tfstate
infra/terraform/terraform.tfstate.backup
infra/terraform/terraform.tfvars
infra/terraform/tfplan*
infra/terraform/terraform.tfvars.bak
