# Dependencies
node_modules/

# Build outputs
dist/
*.tsbuildinfo

# Local environment — never commit credentials
.env
.env.local
*.env

# Package manager artifacts
pnpm-lock.yaml.bak

# Test coverage
coverage/
.cache/

# Coordinator seeds these files into each stage workspace before execution.
# They contain run context, not Claude-produced output.
evidence/runs/*/*/workspace/README.md
evidence/runs/*/*/workspace/work-order.json

# Terraform local state and variable overrides contain secrets
infra/terraform/.terraform/
infra/terraform/.terraform.lock.hcl
infra/terraform/terraform.tfstate
infra/terraform/terraform.tfstate.backup
infra/terraform/terraform.tfvars
infra/terraform/tfplan*
infra/terraform/terraform.tfvars.bak
