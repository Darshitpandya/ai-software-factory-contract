{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://factory.contract/schemas/stage-decision/v1",
  "title": "StageDecision",
  "type": "object",
  "required": ["id", "runId", "stage", "artifactId", "decision", "decidedAt", "decidedBy", "evidenceRef"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "runId": { "type": "string" },
    "stage": { "type": "string" },
    "artifactId": { "type": "string" },
    "decision": {
      "type": "string",
      "enum": ["ACCEPTED", "REJECTED", "WAITING_FOR_HUMAN"]
    },
    "decidedAt": { "type": "string", "format": "date-time" },
    "decidedBy": {
      "type": "string",
      "description": "Identity of the acceptor: system verifier name or authenticated human identity"
    },
    "evidenceRef": {
      "type": "string",
      "description": "SHA-256 or URI of the acceptance evidence"
    },
    "checkName": {
      "type": "string",
      "description": "GitHub Check Run name that issued the verdict (for engineering stage)"
    },
    "checkSha": {
      "type": "string",
      "description": "Exact commit SHA the check was run against"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ruleId": { "type": "string" },
          "severity": { "type": "string", "enum": ["error", "warning", "info"] },
          "message": { "type": "string" },
          "path": { "type": "string" }
        }
      }
    },
    "humanApproval": {
      "type": "object",
      "properties": {
        "approvedBy": { "type": "string" },
        "approvedAt": { "type": "string", "format": "date-time" },
        "portActionRunId": { "type": "string" }
      }
    }
  }
}
