# Copy to .env — never commit .env to git
# All secrets are injected at runtime; never hard-code values here.

# Port control plane
PORT_CLIENT_ID=REPLACE
PORT_CLIENT_SECRET=REPLACE
PORT_BASE_URL=https://api.getport.io

# Claude execution
ANTHROPIC_API_KEY=REPLACE

# GitHub producer App (repo 1)
FACTORY_APP_ID=REPLACE
FACTORY_APP_PRIVATE_KEY_PATH=/run/secrets/github_app_private_key
FACTORY_APP_INSTALLATION_ID=REPLACE
FACTORY_APP_WEBHOOK_SECRET=REPLACE

# Target consumer repos (comma-separated installation IDs for different orgs if needed)
GITHUB_BILLING_REPO=OWNER/factory-reference-billing-api
GITHUB_NOTIFICATION_REPO=OWNER/factory-reference-notification-api

# PostgreSQL — coordinator state
DATABASE_URL=postgresql://factory:factory@localhost:5432/factory
DATABASE_SSL=false

# OpenSandbox
OPENSANDBOX_URL=http://localhost:8080
OPENSANDBOX_API_KEY=REPLACE
OPENSANDBOX_DEFAULT_IMAGE=node:22-alpine

# Factory coordinator
FACTORY_COORDINATOR_PORT=3001
FACTORY_LOG_LEVEL=info
FACTORY_MAX_RETRIES=3
FACTORY_STAGE_TIMEOUT_SECONDS=1800
