{
  "identifier": "factoryReleaseEntity",
  "title": "Factory Release",
  "icon": "Package",
  "type": "entity",
  "blueprint": "factoryRelease",
  "requiredQueryParams": [
    "identifier",
    "blueprint"
  ],
  "widgets": [
    {
      "id": "rel-grp",
      "type": "grouper",
      "displayMode": "tabs",
      "activeGroupUrlParam": "activeTab",
      "groupsOrder": [
        "Overview",
        "Related Entities",
        "Runs",
        "Audit Log"
      ],
      "groups": [
        {
          "title": "Overview",
          "widgets": [
            {
              "id": "rel-ov-dw",
              "type": "dashboard-widget",
              "layout": [
                {
                  "height": 400,
                  "columns": [
                    {
                      "id": "rel-actions",
                      "size": 12
                    }
                  ]
                },
                {
                  "height": 500,
                  "columns": [
                    {
                      "id": "rel-info",
                      "size": 12
                    }
                  ]
                }
              ],
              "widgets": [
                {
                  "id": "rel-actions",
                  "type": "action-card-widget",
                  "title": "Release Actions",
                  "actions": [
                    {
                      "action": "runFactoryEvaluation"
                    },
                    {
                      "action": "promoteFactoryRelease"
                    }
                  ]
                },
                {
                  "id": "rel-info",
                  "type": "entity-info",
                  "title": "Release Details",
                  "blueprint": "{{blueprint}}",
                  "entity": "{{url.identifier}}",
                  "hiddenQuery": [
                    "$identifier",
                    "$createdBy",
                    "$updatedBy",
                    "$blueprint",
                    "$datasource",
                    "$icon",
                    "$team"
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Related Entities",
          "widgets": [
            {
              "id": "rel-rel",
              "type": "grouper",
              "displayMode": "switch",
              "groups": [
                {
                  "title": "Table",
                  "icon": "Table",
                  "widgets": [
                    {
                      "id": "rel-tbl",
                      "type": "table-entities-explorer-by-direction"
                    }
                  ]
                },
                {
                  "title": "Graph",
                  "icon": "Relation",
                  "widgets": [
                    {
                      "id": "rel-g",
                      "type": "graph-entities-explorer",
                      "hiddenBlueprints": [],
                      "dataset": {
                        "combinator": "or",
                        "rules": [
                          {
                            "operator": "relatedTo",
                            "value": "{{url.identifier}}",
                            "blueprint": "{{blueprint}}"
                          },
                          {
                            "combinator": "and",
                            "rules": [
                              {
                                "operator": "=",
                                "value": "{{url.identifier}}",
                                "property": "$identifier"
                              },
                              {
                                "operator": "=",
                                "value": "{{blueprint}}",
                                "property": "$blueprint"
                              }
                            ]
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Runs",
          "widgets": [
            {
              "id": "rel-runs",
              "type": "runs-table",
              "title": "Action Runs",
              "query": {}
            }
          ]
        },
        {
          "title": "Audit Log",
          "widgets": [
            {
              "id": "rel-audit",
              "type": "table-audit-log",
              "query": {}
            }
          ]
        }
      ]
    }
  ],
  "visibility": "org",
  "protected": true
}