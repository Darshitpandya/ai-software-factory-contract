{
  "identifier": "factoryReleaseDashboard",
  "title": "Factory Releases",
  "icon": "Package",
  "type": "dashboard",
  "section": "software_catalog",
  "showInSidebar": true,
  "widgets": [
    {
      "id": "frd-root",
      "type": "dashboard-widget",
      "layout": [
        {
          "height": 400,
          "columns": [
            {
              "id": "frd-actions",
              "size": 12
            }
          ]
        },
        {
          "height": 500,
          "columns": [
            {
              "id": "frd-board",
              "size": 12
            }
          ]
        },
        {
          "height": 400,
          "columns": [
            {
              "id": "frd-bar",
              "size": 6
            },
            {
              "id": "frd-bar2",
              "size": 6
            }
          ]
        },
        {
          "height": 450,
          "columns": [
            {
              "id": "frd-releases",
              "size": 12
            }
          ]
        },
        {
          "height": 450,
          "columns": [
            {
              "id": "frd-prom",
              "size": 12
            }
          ]
        },
        {
          "height": 450,
          "columns": [
            {
              "id": "frd-runs",
              "size": 12
            }
          ]
        }
      ],
      "widgets": [
        {
          "id": "frd-actions",
          "type": "action-card-widget",
          "title": "Release Lifecycle Actions",
          "actions": [
            {
              "action": "runFactoryEvaluation"
            },
            {
              "action": "promoteFactoryRelease"
            },
            {
              "action": "evaluateRelease"
            }
          ]
        },
        {
          "id": "frd-board",
          "type": "board",
          "title": "Factory Releases — by Status",
          "blueprintConfig": {
            "factoryRelease": {
              "groupSettings": {
                "groupBy": [
                  "status"
                ]
              }
            }
          },
          "dataset": {
            "combinator": "and",
            "rules": [
              {
                "operator": "=",
                "property": "$blueprint",
                "value": "factoryRelease"
              }
            ]
          },
          "entitiesQueryMode": "optimized"
        },
        {
          "id": "frd-bar",
          "type": "bar-chart",
          "title": "Runs — by Factory Release",
          "blueprint": "factoryRun",
          "property": "property#currentStage",
          "dataset": {
            "combinator": "and",
            "rules": [
              {
                "operator": "=",
                "property": "$blueprint",
                "value": "factoryRun"
              }
            ]
          }
        },
        {
          "id": "frd-bar2",
          "type": "bar-chart",
          "title": "Runs — by Model Used",
          "blueprint": "factoryRun",
          "property": "property#modelUsed",
          "dataset": {
            "combinator": "and",
            "rules": [
              {
                "operator": "=",
                "property": "$blueprint",
                "value": "factoryRun"
              }
            ]
          }
        },
        {
          "id": "frd-releases",
          "type": "table-entities-explorer",
          "title": "All Factory Releases",
          "displayMode": "widget",
          "dataset": {
            "combinator": "and",
            "rules": [
              {
                "operator": "=",
                "property": "$blueprint",
                "value": "factoryRelease"
              }
            ]
          }
        },
        {
          "id": "frd-prom",
          "type": "table-entities-explorer",
          "title": "Promotion Decisions",
          "displayMode": "widget",
          "dataset": {
            "combinator": "and",
            "rules": [
              {
                "operator": "=",
                "property": "$blueprint",
                "value": "promotionDecision"
              }
            ]
          }
        },
        {
          "id": "frd-runs",
          "type": "table-entities-explorer",
          "title": "Factory Runs — Cost & Model Breakdown",
          "displayMode": "widget",
          "dataset": {
            "combinator": "and",
            "rules": [
              {
                "operator": "=",
                "property": "$blueprint",
                "value": "factoryRun"
              },
              {
                "operator": "isNotEmpty",
                "property": "estimatedCostUsd"
              }
            ]
          }
        }
      ]
    }
  ],
  "sidebar": "catalog",
  "visibility": "org",
  "protected": false,
  "after": "serviceCatalog"
}
