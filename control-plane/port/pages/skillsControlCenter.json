{
  "identifier": "skillsControlCenter",
  "title": "Skills Registry",
  "icon": "Book",
  "type": "dashboard",
  "section": "software_catalog",
  "showInSidebar": true,
  "widgets": [
    {
      "id": "scc-root",
      "type": "dashboard-widget",
      "layout": [
        {
          "height": 500,
          "columns": [
            {
              "id": "scc-board",
              "size": 12
            }
          ]
        },
        {
          "height": 400,
          "columns": [
            {
              "id": "scc-bar",
              "size": 12
            }
          ]
        },
        {
          "height": 450,
          "columns": [
            {
              "id": "scc-skills",
              "size": 12
            }
          ]
        },
        {
          "height": 450,
          "columns": [
            {
              "id": "scc-comps",
              "size": 12
            }
          ]
        }
      ],
      "widgets": [
        {
          "id": "scc-board",
          "type": "board",
          "title": "Skills — by Factory Stage",
          "blueprintConfig": {
            "factorySkill": {
              "groupSettings": {
                "groupBy": [
                  "factory"
                ]
              }
            }
          },
          "dataset": {
            "combinator": "and",
            "rules": [
              {
                "operator": "=",
                "property": "$blueprint",
                "value": "factorySkill"
              }
            ]
          },
          "entitiesQueryMode": "optimized"
        },
        {
          "id": "scc-bar",
          "type": "bar-chart",
          "title": "Skills — by Stage",
          "blueprint": "factorySkill",
          "property": "property#factory",
          "dataset": {
            "combinator": "and",
            "rules": [
              {
                "operator": "=",
                "property": "$blueprint",
                "value": "factorySkill"
              }
            ]
          }
        },
        {
          "id": "scc-skills",
          "type": "table-entities-explorer",
          "title": "All 15 Skills — SHA-256 Locked",
          "displayMode": "widget",
          "dataset": {
            "combinator": "and",
            "rules": [
              {
                "operator": "=",
                "property": "$blueprint",
                "value": "factorySkill"
              }
            ]
          }
        },
        {
          "id": "scc-comps",
          "type": "table-entities-explorer",
          "title": "Factory Components",
          "displayMode": "widget",
          "dataset": {
            "combinator": "and",
            "rules": [
              {
                "operator": "=",
                "property": "$blueprint",
                "value": "factoryComponent"
              }
            ]
          }
        }
      ]
    }
  ],
  "sidebar": "catalog",
  "visibility": "org",
  "protected": false,
  "after": "agentControlCenter"
}
